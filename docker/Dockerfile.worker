# Ingestion + AI workers. One image serves every worker class; the compose service
# picks which entrypoint to run, so the scheduler, ingest, outbox relay, status
# updater, and AI indexer can never drift apart in dependencies or parser version.
FROM node:24-alpine AS deps

WORKDIR /app
COPY package.json package-lock.json ./
# `npm install` (not `npm ci`) so the Linux-native optional binaries and their
# transitive deps resolve for this platform — the committed lock is generated on
# Windows and omits them, which makes strict `npm ci` fail in this image. The workers
# run TypeScript directly through Node's type stripping and never invoke tsc.
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force

FROM node:24-alpine AS runtime

# dumb-init makes PID 1 forward SIGTERM, which is what triggers the graceful
# shutdown path in lib/ingestion/worker/runtime.ts.
RUN apk add --no-cache dumb-init

ENV NODE_ENV=production \
    NODE_OPTIONS=--max-old-space-size=1536 \
    INGESTION_METRICS_PORT=9464

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
# The AI indexer reaches lib/ai → lib/tenders → lib/db/lib/storage, and lib/ai
# imports messages/*.json for bilingual output, so the whole lib tree ships.
# Only relative-path imports work here: Node's type stripping does not resolve
# the "@/" tsconfig alias, so any module using it is web-app-only by definition.
COPY lib ./lib
COPY messages ./messages
COPY data ./data
COPY workers ./workers
COPY scripts ./scripts
# seed-cpv-codes.mts reads this catalog from the working directory.
COPY ["CPV2008en(Annex Ia & Ib).csv", "./"]

# The image ships no .env: secrets come from the orchestrator's secret store (§16).
USER node

EXPOSE 9464

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.INGESTION_METRICS_PORT||9464)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON", "--experimental-strip-types", "workers/ingest.mts"]
