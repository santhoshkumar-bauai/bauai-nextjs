# Ingestion workers. One image serves every worker class; the compose service
# picks which entrypoint to run, so the scheduler, ingest, outbox relay, and status
# updater can never drift apart in dependencies or parser version.
FROM node:24-alpine AS deps

WORKDIR /app
COPY package.json package-lock.json ./
# `npm ci` needs the dev dependency tree omitted; the workers run TypeScript
# directly through Node's type stripping and never invoke tsc at runtime.
RUN npm ci --omit=dev && npm cache clean --force

FROM node:24-alpine AS runtime

# dumb-init makes PID 1 forward SIGTERM, which is what triggers the graceful
# shutdown path in lib/ingestion/worker/runtime.ts.
RUN apk add --no-cache dumb-init

ENV NODE_ENV=production \
    NODE_OPTIONS=--max-old-space-size=1536 \
    INGESTION_METRICS_PORT=9464

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY lib/ingestion ./lib/ingestion
COPY workers ./workers
COPY scripts/ingestion-bootstrap.mts scripts/ingestion-backfill.mts ./scripts/
COPY scripts/ingestion-replay-dlq.mts scripts/ingestion-parse-fixture.mts ./scripts/
COPY scripts/ingestion-smoke.mts scripts/fetch-documents.mts ./scripts/
COPY scripts/inspect-document-url.mts ./scripts/

# The image ships no .env: secrets come from the orchestrator's secret store (§16).
USER node

EXPOSE 9464

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.INGESTION_METRICS_PORT||9464)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON", "--experimental-strip-types", "workers/ingest.mts"]
