# MongoDB
# Ingestion requires a replica set: transactions and change streams depend on it.
# Local single-node set: docker compose -f docker/docker-compose.yml up -d mongo
MONGODB_URI=mongodb://127.0.0.1:27017/bauai?replicaSet=rs0&directConnection=true
MONGODB_DB=bauai
# Optional override; defaults to the CPV 2008 CSV in the project root.
CPV_EN_CSV_PATH=

# --- Tender ingestion workers (docs/INGESTION_WORKER.md) ---

# Redis. Durable work queue (Streams) plus the outbox fan-out channel (pub/sub).
REDIS_URL=redis://127.0.0.1:6379
INGESTION_REDIS_PREFIX=bauai:ingestion
INGESTION_OUTBOX_CHANNEL=bauai:tenders:events

# S3-compatible storage for raw official notice payloads.
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_REGION=
S3_KEY_ID=
S3_APPLICATION_KEY=
S3_RAW_NOTICE_PREFIX=tenders/raw

# Optional. Without it TED uses the public Search API as the raw payload of record;
# with it the adapter fetches official per-notice eForms XML instead.
TED_API_KEY=

# Worker tuning. Intervals and rate limits live in the `source_configs` collection
# so they can change without a deploy; these are process-level settings only.
INGESTION_CONCURRENCY=8
INGESTION_VISIBILITY_TIMEOUT_MS=300000
INGESTION_MAX_ATTEMPTS=5
INGESTION_SHUTDOWN_GRACE_MS=30000
INGESTION_METRICS_PORT=9464
INGESTION_LOG_LEVEL=info
# Writes MongoDB but publishes no application events (cutover shadow mode).
INGESTION_SHADOW_MODE=false

# --- Tender document retrieval (docs/INGESTION_WORKER.md) ---
DOCUMENTS_ENABLED=true
S3_DOCUMENT_PREFIX=tenders/documents
DOCUMENTS_CONCURRENCY=4
# Per portal, not global. Modest on purpose: these are small public services and an
# IP ban is the practical failure mode.
DOCUMENTS_RATE_PER_HOST=10
DOCUMENTS_CONCURRENCY_PER_HOST=2
DOCUMENTS_MAX_FILE_BYTES=100000000
DOCUMENTS_MAX_TOTAL_BYTES=500000000
DOCUMENTS_MAX_FILES=100
# Characters of extracted text mirrored into MongoDB; the full text always goes to S3.
DOCUMENTS_MAX_TEXT_CHARS=100000
# Only fetch documents for tenders still worth bidding on (OPEN/CLOSING_SOON/UPCOMING).
# Set false to fetch for every tender, including historical awards.
DOCUMENTS_BIDDABLE_ONLY=true

# Better Auth
# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Transactional email (Resend)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=BAU AI <bauai@email-notifications.educationalhub.in>

# Google Maps Platform (server-side; enable Places API (New))
GOOGLE_PLACES_API=
# Optional legacy/fallback variables. Geocoding is only used if Place Details (New) fails.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_GEOCODE_API_KEY=
# GOOGLE_PLACES_API enables Places automatically; this flag only applies to GOOGLE_MAPS_API_KEY.
GOOGLE_PLACES_ENABLED=false

# Gemini API (server-side CPV classification)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional Google OAuth
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Microsoft OAuth
# Callback URL: http://localhost:3000/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
