# MongoDB
# Ingestion requires a replica set: transactions and change streams depend on it.
# AI retrieval additionally requires Atlas Search/Vector Search — locally that
# means the mongodb-atlas-local image: docker compose -f docker/docker-compose.yml up -d mongo
# (published on host port 27018 by default; 27017 is often a host mongod).
MONGODB_URI=mongodb://127.0.0.1:27018/bauai?directConnection=true
MONGODB_DB=bauai
# One-time local -> VM snapshot used by `npm run db:replicate -- --replace`.
# Keep the password out of this file; set it only in the shell running the command.
MONGODB_REPLICA_SOURCE_URI=mongodb://localhost:27018/bauai?directConnection=true
MONGODB_REPLICA_TARGET_HOST=34.68.209.243:27017
MONGODB_REPLICA_TARGET_USERNAME=admin
MONGODB_REPLICA_TARGET_PASSWORD=
# Optional override; defaults to the CPV 2008 CSV in the project root.
CPV_EN_CSV_PATH=

# --- Tender ingestion workers (docs/INGESTION_WORKER.md) ---

# Redis. Durable work queue (Streams), the outbox fan-out channel (pub/sub),
# and the BullMQ AI queues (which require Redis >= 6.2). The docker redis:7 is
# published on host port 6380 by default (6379 is often a host Redis 5.x).
REDIS_URL=redis://127.0.0.1:6380
INGESTION_REDIS_PREFIX=bauai:ingestion
INGESTION_OUTBOX_CHANNEL=bauai:tenders:events

# S3-compatible storage for raw official notice payloads.
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_REGION=
S3_KEY_ID=
S3_APPLICATION_KEY=
S3_RAW_NOTICE_PREFIX=tenders/raw
# Prefix for user-uploaded company files (logos + knowledge-base documents),
# served via presigned URLs. Shares the bucket/credentials above.
S3_COMPANY_PREFIX=companies

# --- ONLYOFFICE Document Filler ---
# Browser-facing Document Server origin. NEXT_PUBLIC_* is baked into the web image.
NEXT_PUBLIC_DS_URL=https://docs.example.com
# Server-to-server URL from the BAU AI web/worker containers.
DS_INTERNAL_URL=http://onlyoffice
# BAU AI origin reachable from Document Server callbacks.
INTERNAL_APP_URL=http://web:3000
PUBLIC_APP_URL=https://app.example.com
# Use two independent, random secrets (32+ bytes). OO_JWT_SECRET is shared with
# the Document Server; OO_APP_JWT_SECRET signs app-internal upload grants
# (legacy name OO_AI_JWT_SECRET is still honored).
OO_JWT_SECRET=replace-with-a-random-onlyoffice-secret
OO_APP_JWT_SECRET=replace-with-a-different-random-app-secret
S3_WORKSPACE_DOCUMENT_PREFIX=workspace-documents
ONLYOFFICE_ENABLED=false
ONLYOFFICE_CONVERSION_CONCURRENCY=2
ONLYOFFICE_REDIS_PREFIX={bauai:onlyoffice}
# Community Edition uses the built-in deterministic OOXML copy engine. Enable
# this only when DS_INTERNAL_URL points at an edition with /docbuilder service.
ONLYOFFICE_DOCUMENT_BUILDER_ENABLED=false

# Optional. Without it TED uses the public Search API as the raw payload of record;
# with it the adapter fetches official per-notice eForms XML instead.
TED_API_KEY=

# Worker tuning. Intervals and rate limits live in the `source_configs` collection
# so they can change without a deploy; these are process-level settings only.
INGESTION_CONCURRENCY=8
INGESTION_VISIBILITY_TIMEOUT_MS=300000
INGESTION_MAX_ATTEMPTS=5
INGESTION_SHUTDOWN_GRACE_MS=30000
INGESTION_METRICS_PORT=9464
INGESTION_LOG_LEVEL=info
# Writes MongoDB but publishes no application events (cutover shadow mode).
INGESTION_SHADOW_MODE=false

# --- Tender document retrieval (docs/INGESTION_WORKER.md) ---
DOCUMENTS_ENABLED=true
S3_DOCUMENT_PREFIX=tenders/documents
DOCUMENTS_CONCURRENCY=4
# Per portal, not global. Modest on purpose: these are small public services and an
# IP ban is the practical failure mode.
DOCUMENTS_RATE_PER_HOST=10
DOCUMENTS_CONCURRENCY_PER_HOST=2
DOCUMENTS_MAX_FILE_BYTES=100000000
DOCUMENTS_MAX_TOTAL_BYTES=500000000
DOCUMENTS_MAX_FILES=100
# Characters of extracted text mirrored into MongoDB; the full text always goes to S3.
DOCUMENTS_MAX_TEXT_CHARS=100000
# Only fetch documents for tenders still worth bidding on (OPEN/CLOSING_SOON/UPCOMING).
# Set false to fetch for every tender, including historical awards.
DOCUMENTS_BIDDABLE_ONLY=true

# Better Auth
# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Transactional email (Resend)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=BAU AI <bauai@bauaiapp.de>
# Printed in the footer of every email as the reply-to address.
EMAIL_SUPPORT_ADDRESS=info@bauai.eu
# Booking page for the onboarding demo and support slots. Defaults to the
# Outlook Bookings page in lib/email/brand.ts; set only to point elsewhere.
EMAIL_BOOKING_URL=
# Set to "off" to stop finished tender reports from mailing the whole company.
# Recommended locally, where every generation would notify real addresses.
EMAIL_REPORT_NOTIFICATIONS=
# Links in emails are built from PUBLIC_APP_URL (see above), NOT BETTER_AUTH_URL.

# Google Maps Platform (server-side; enable Places API (New))
GOOGLE_PLACES_API=
# Optional legacy/fallback variables. Geocoding is only used if Place Details (New) fails.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_GEOCODE_API_KEY=
# GOOGLE_PLACES_API enables Places automatically; this flag only applies to GOOGLE_MAPS_API_KEY.
GOOGLE_PLACES_ENABLED=false

# Gemini API (server-side CPV classification)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional Google OAuth
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Microsoft OAuth
# Callback URL: http://localhost:3000/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- AI subsystem (embeddings, retrieval; lib/ai/) ---
# Uses GEMINI_API_KEY / GEMINI_MODEL from the Gemini section above.

# Embedding identity — stamped on every stored vector; bump EMBEDDING_VERSION
# to trigger a sweep-driven re-embed of notices and chunks.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_VERSION=2026-08
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_RPM=100

# Role -> "provider:model" map, JSON. Defaults derive from GEMINI_* above.
# AI_MODEL_ROLES={"embedding":"gemini:gemini-embedding-001","extraction":"gemini:gemini-2.5-flash-lite","reasoning":"gemini:gemini-2.5-flash-lite"}

# BullMQ prefix (hash-tagged for Redis Cluster slot affinity).
AI_REDIS_PREFIX={bauai:ai}
AI_WORKER_CONCURRENCY=4

# Retrieval: $rankFusion fast path (needs MongoDB >= 8.1 everywhere) and the
# reranker slot (noop until the cross-encoder lands; llm = Gemini-scored).
AI_USE_RANK_FUSION=false
AI_RERANKER=noop

# --- Clara agent (lib/ai/agent/) ---
# The agent role defaults to gemini:gemini-3.5-flash. To switch providers set
# AI_MODEL_ROLES with an "agent" entry, e.g. {"agent":"anthropic:claude-sonnet-4-5"}
# and provide the matching key below.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
AI_AGENT_MAX_ITERATIONS=6
# Thinking models spend reasoning tokens from this same budget — keep it high.
AI_AGENT_MAX_OUTPUT_TOKENS=8192
AI_AGENT_HISTORY_MAX_MESSAGES=30
# Global (dashboard) chats get longer tool chains than tender chats.
AI_AGENT_GLOBAL_MAX_ITERATIONS=8
# Reasoning effort for thinking-capable models: none | low | medium | high.
# Maps to Gemini thinkingConfig, OpenAI reasoningEffort, Anthropic thinking
# budget. Unset = provider default (dynamic thinking).
# AI_AGENT_REASONING=medium

# --- Full tender report (lib/ai/report/) ---
# The report is the single most demanding synthesis in the product: it reads
# every tender artifact and the whole company profile in one call. Point it at
# the STRONGEST model you have access to — it falls back to the agent model
# only so an unconfigured deployment still works.
# AI_REPORT_MODEL=anthropic:<your-best-anthropic-model>
# AI_REPORT_MODEL=openai:<your-best-openai-model>
# AI_REPORT_MODEL=gemini:<your-best-gemini-model>
# (equivalently: AI_MODEL_ROLES={"report":"..."} — that wins over AI_REPORT_MODEL)
AI_REPORT_MAX_OUTPUT_TOKENS=32768
# Defaults to "high" for this role — the report is worth the thinking budget.
AI_REPORT_REASONING=high
# Context breadth: document excerpts swept into the report prompt.
AI_REPORT_MAX_TENDER_CHUNKS=40
AI_REPORT_MAX_COMPANY_CHUNKS=16
# PDF export renders the report with headless Chromium. Install it on the web
# host once: npx playwright install chromium
# (DOCX export is pure JS and needs nothing.)

# --- AI tender matching (lib/ai/match) -------------------------------------
# The "AI Matched" feed on /tenders. The company is embedded as several facet
# vectors (capabilities, reference projects, qualifications, one per uploaded
# document), each retrieves against vx_tender_search_documents, the lists are
# fused with the deterministic CPV/geo/time ranking, and the head is judged.
# Requires Atlas Search — with plain mongod the tab reports "unavailable" and
# the UI falls back to the classic feed.
AI_MATCH_ENABLED=true
# Kill switch aside, this role judges 200 tenders against the whole company
# profile. Point it at a strong model; falls back through AI_REPORT_MODEL.
# AI_MATCH_MODEL=gemini:<your-best-gemini-model>
# NOTE: the deterministic gateway registers only the Gemini provider, so this
# must resolve to a gemini: ref (same constraint as extraction/reasoning).
# Rows served per company — also the judging depth.
AI_MATCH_RANK_CAP=200
# Distinct tenders kept after fusion, before scoring.
AI_MATCH_POOL_CAP=400
# $vectorSearch limit per facet, and its candidate pool. numCandidates is
# generous because deadline/isVisible are POST-filters (an Atlas range filter
# would drop the 42% of tenders that have no deadline).
AI_MATCH_CANDIDATES_PER_FACET=250
AI_MATCH_NUM_CANDIDATES=4000
AI_MATCH_MAX_FACETS=24
# 200 tenders in batches of 10, 3 calls in flight — about 2 minutes per run.
AI_MATCH_JUDGE_BATCH=10
AI_MATCH_JUDGE_CONCURRENCY=3
# A finished run older than this is refreshed by the background sweep.
AI_MATCH_STALE_HOURS=6
# BM25 arm over tender_search_documents.text. Off by default: a company
# profile is a keyword bag, which is what BM25 handles worst, and the
# exact-match role is already filled by the CPV prefix ladder.
AI_MATCH_LEXICAL=false
# Bump either to invalidate stored profiles / scores and force a rebuild.
MATCH_PIPELINE_VERSION=v1
COMPANY_PROFILE_VERSION=v1

# Chunking (lib/ai/chunking): bump CHUNKER_VERSION to re-chunk everything.
CHUNKER_VERSION=v1
CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=1200

# ---------------------------------------------------------------------------
# Legacy data migration (scripts/migrate-*.mts) — read-only access to the
# mvp1-bauai Supabase project. Only needed while migrating; unset afterwards.
# The service-role key bypasses RLS, which the migration needs because the
# legacy schema left 29 tables without policies. Use the ROTATED key.
# ---------------------------------------------------------------------------
MIGRATION_SUPABASE_URL=https://<project-ref>.supabase.co
MIGRATION_SUPABASE_SERVICE_ROLE_KEY=

# Dora native editor panel (v2): opt-in switch pointing document-filler at the
# :9000 UI-dev Document Server, and the editor origins allowed to call
# /api/dora-gateway/* (comma-separated; empty disables the panel embed).
ONLYOFFICE_UI_DEV=false
ONLYOFFICE_DEV_URL=http://localhost:9000
ONLYOFFICE_DEV_JWT_SECRET=
DORA_EDITOR_ORIGINS=
# V2 uses live editor snapshots and stable ranges. Set false for an immediate
# rollback to the legacy exact-text proposal engine.
DORA_EDIT_ENGINE_V2=true
# Spreadsheet Dora starts with bounded, live read-only context. Disable this
# flag to hide/reject the spreadsheet capability without affecting Word Dora.
DORA_SPREADSHEET_ENABLED=true
# Guarded spreadsheet values/formulas: Gemini proposes a bounded change set;
# the user must preview and Apply it in the editor. Set false for an immediate
# server + editor kill switch while keeping read-only Spreadsheet Dora.
DORA_SPREADSHEET_WRITES_ENABLED=true
# Optional Developer-edition host connector. Community 9.4 remains the
# baseline and uses the native spreadsheet WebApp adapter when this is false.
DORA_SPREADSHEET_DEVELOPER_CONNECTOR=false
# Dora model roles. AI_DORA_MODEL drives chat + the V2 edit planner (falls back
# through AI_REPORT_MODEL to the agent model). AI_DORA_FAST_MODEL drives the
# streaming edit tier (rewrite selection / continue writing) where first-token
# latency matters more than planning depth — point it at a small fast model;
# falls back through AI_DORA_MODEL.
# AI_DORA_MODEL=gemini:gemini-3.5-flash
# AI_DORA_FAST_MODEL=gemini:gemini-2.5-flash-lite
# Field discovery is deliberately pinned separately from conversational Dora.
# AI_DORA_FILL_MODEL=gemini:gemini-3.7-flash
