<?xml version="1.0" encoding="UTF-8"?>
<GAEB xmlns="http://www.gaeb.de/GAEB_DA_XML/DA83/3.2">
  <GAEBInfo>
    <Version>3.2</Version>
    <VersDate>2013-10</VersDate>
  </GAEBInfo>
  <PrjInfo>
    <Name>Schulzentrum Musterstadt</Name>
    <LblPrj>Sanierung und Erweiterung</LblPrj>
  </PrjInfo>
  <Award>
    <DP>83</DP>
    <AwardInfo>
      <Cur>EUR</Cur>
      <CurLbl>Euro</CurLbl>
      <OpenDate>2026-09-15</OpenDate>
      <VAT>19.00</VAT>
    </AwardInfo>
    <OWN>
      <Address>
        <Name1>Stadt Musterstadt</Name1>
        <Street>Rathausplatz 1</Street>
        <PCode>06844</PCode>
        <City>Musterstadt</City>
        <Email>vergabe@musterstadt.de</Email>
      </Address>
    </OWN>
    <AddText>
      <Text><p><span>Arbeiten bei laufendem Schulbetrieb.</span></p></Text>
    </AddText>
    <BoQ ID="boq1">
      <BoQInfo>
        <Name>LV Sanitaer und Heizung</Name>
        <Date>2026-08-01</Date>
        <BoQBkdn>
          <Type>BoQLevel</Type>
          <Length>2</Length>
          <Num>Yes</Num>
          <LblBoQBkdn>Titel</LblBoQBkdn>
        </BoQBkdn>
        <BoQBkdn>
          <Type>BoQLevel</Type>
          <Length>2</Length>
          <Num>Yes</Num>
          <LblBoQBkdn>Abschnitt</LblBoQBkdn>
        </BoQBkdn>
        <BoQBkdn>
          <Type>Item</Type>
          <Length>4</Length>
          <Num>Yes</Num>
        </BoQBkdn>
      </BoQInfo>
      <BoQBody>
        <Remark ID="r1">
          <Description>
            <CompleteText>
              <DetailTxt>
                <Text><p><span>Vorbemerkungen: Bestandsgebaeude, eingeschraenkte Zufahrt.</span></p></Text>
              </DetailTxt>
            </CompleteText>
          </Description>
        </Remark>
        <BoQCtgy RNoPart="1" ID="c1">
          <LblTx><p><span>Sanitaer</span></p></LblTx>
          <BoQBody>
            <BoQCtgy RNoPart="1" ID="c11">
              <LblTx><p><span>Demontage</span></p></LblTx>
              <BoQBody>
                <Itemlist>
                  <Item ID="id1" RNoPart="3">
                    <Qty>50.000</Qty>
                    <QU>lfdm</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><p><span>Rohrleitungen aus schwarzem oder verzinktem Stahlrohr, DN15 bis DN80, einschliesslich Form- und Verbindungsstuecke, Demontagehoehe bis 5 m, demontieren und abtransportieren.</span></p></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><p><span>Rohrleitungen Stahl demontieren</span></p></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="id2" RNoPart="4">
                    <Provis/>
                    <Qty>10.000</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><p><span>Bedarfsposition: Absperrventile im Bestand austauschen.</span></p></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt>
                            <TextOutlTxt><p><span>Absperrventile austauschen</span></p></TextOutlTxt>
                          </OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                </Itemlist>
              </BoQBody>
            </BoQCtgy>
          </BoQBody>
        </BoQCtgy>
        <BoQCtgy RNoPart="2" ID="c2">
          <LblTx><p><span>Heizung</span></p></LblTx>
          <BoQBody>
            <Itemlist>
              <Item ID="id3" RNoPart="1">
                <LumpSumItem>Yes</LumpSumItem>
                <QU>psch</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text><p><span>Baustelleneinrichtung fuer Heizungsarbeiten, pauschal.</span></p></Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt><p><span>Baustelleneinrichtung pauschal</span></p></TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="id4" RNoPart="2">
                <ALNGroupNo>1</ALNGroupNo>
                <ALNSerNo>0</ALNSerNo>
                <Qty>20.000</Qty>
                <QU>m2</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text><p><span>Grundposition: Zementestrich als Heizestrich herstellen.</span></p></Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt><p><span>Heizestrich Grundposition</span></p></TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="id5" RNoPart="3">
                <ALNGroupNo>1</ALNGroupNo>
                <ALNSerNo>1</ALNSerNo>
                <Qty>20.000</Qty>
                <QU>m2</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text><p><span>Alternativposition: Schnellestrich statt Zementestrich.</span></p></Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt><p><span>Heizestrich Alternativposition</span></p></TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item ID="id6" RNoPart="4">
                <Qty>8.000</Qty>
                <QU>h</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt>
                      <Text><p><span>Stundenlohnarbeiten Anlagenmechaniker SHK.</span></p></Text>
                    </DetailTxt>
                    <OutlineText>
                      <OutlTxt>
                        <TextOutlTxt><p><span>Stundenlohnarbeiten SHK</span></p></TextOutlTxt>
                      </OutlTxt>
                    </OutlineText>
                  </CompleteText>
                </Description>
              </Item>
            </Itemlist>
          </BoQBody>
        </BoQCtgy>
      </BoQBody>
    </BoQ>
  </Award>
</GAEB>
