# Ingestion deploy env — copy to deploy/.env and fill in.
# The image ships no secrets; every value here comes from your orchestrator / VM.
# (deploy/.env is gitignored — never commit real credentials.)

# ── MongoDB ─────────────────────────────────────────────────────────────────
# MUST be a replica set (transactions + change streams). You already run this.
MONGODB_URI=mongodb://USER:PASSWORD@YOUR_MONGO_HOST:27017/?replicaSet=rs0&authSource=admin
MONGODB_DB=bauai

# ── Redis (GCP Memorystore, same VPC as the workers) ────────────────────────
REDIS_URL=redis://MEMORYSTORE_IP:6379
INGESTION_REDIS_PREFIX=bauai:ingestion

# ── Object storage: GCS via its S3-compatible XML API ───────────────────────
# The S3 client uses path-style addressing, which GCS interop requires.
S3_ENDPOINT=https://storage.googleapis.com
S3_REGION=europe-west3            # your bucket's location ("auto" also works)
S3_BUCKET_NAME=bauai-tenders
S3_KEY_ID=GOOG1EXAMPLE...         # HMAC access id  (see deploy/README.md)
S3_APPLICATION_KEY=...            # HMAC secret
S3_RAW_NOTICE_PREFIX=tenders/raw
S3_DOCUMENT_PREFIX=tenders/documents

# ── Sources ─────────────────────────────────────────────────────────────────
TED_API_KEY=                      # optional; blank uses the public TED search API

# ── Documents worker ────────────────────────────────────────────────────────
DOCUMENTS_ENABLED=true
DOCUMENTS_BIDDABLE_ONLY=true      # false = fetch docs for closed tenders too (costly)
# Headless-browser resolvers (rib-meinauftrag). Keep false on the alpine image;
# set true only when running the Playwright-based documents image.
DOCUMENTS_BROWSER_ENABLED=false

# ── AI worker: embedding, classification, extraction, matching ──────────────
GEMINI_API_KEY=                   # required by ai-indexer: embeddings + default models
# OPENAI_API_KEY=                 # only if AI_MODEL_ROLES routes a role to openai
# ANTHROPIC_API_KEY=              # only if AI_MODEL_ROLES routes a role to anthropic
AI_REDIS_PREFIX=bauai:ai
# AI_WORKER_CONCURRENCY=4
# AI_MATCH_ENABLED=true

# ── Ops ─────────────────────────────────────────────────────────────────────
INGESTION_LOG_LEVEL=info
INGESTION_SHADOW_MODE=false       # true = write Mongo but publish no app events

# ── Deploy knobs (read by docker-compose.prod.yml) ──────────────────────────
IMAGE_TAG=latest
INGEST_REPLICAS=2
DOCUMENT_REPLICAS=1
